# Application
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/school_manager

# Debug mode (never enable in production)
FLASK_DEBUG=1

# SMS Provider (leave empty to disable)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=
SMS_API_URL=

# Telegram Bot (leave empty to disable)
TELEGRAM_BOT_TOKEN=

# Bale Bot (leave empty to disable)
BALE_BOT_TOKEN=

# Email / SMTP (leave empty to disable)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_DEFAULT_SENDER=

# File Management
FILE_STORAGE_BACKEND=local
FILE_STORAGE_PATH=
FILE_MAX_UPLOAD_SIZE=5242880

# ZarinPal Payment Gateway (sandbox for development)
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
